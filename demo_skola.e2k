$ PROGRAM INFORMATION
  PROGRAM "ETABS" VERSION "23.0.0"

$ TITLE
  TITLE "Rekonstrukcija OS Josip Juraj Strossmayer, Varsavska ulica, Zagreb"

$ MATERIAL PROPERTIES
  MATERIAL "OPEKA_PUNA" TYPE "MASONRY"
  MATERIAL "OPEKA_PUNA" ISOTROPIC E 3000000 U 0.15
  MATERIAL "OPEKA_PUNA" DESIGN "CONCRETE" FC 4000
  MATERIAL "S235" TYPE "STEEL"
  MATERIAL "S235" ISOTROPIC E 210000000 U 0.3
  MATERIAL "S235" DESIGN "STEEL" FY 235000 FU 360000
  MATERIAL "C25/30" TYPE "CONCRETE"
  MATERIAL "C25/30" ISOTROPIC E 31000000 U 0.2
  MATERIAL "C25/30" DESIGN "CONCRETE" FC 25000

$ FRAME SECTIONS
  FRAME "NPI_200" MAT "S235" SHAPE "I/WIDE FLANGE" T3 0.20 T2 0.09
  FRAME "BM_DRVO_14x24" MAT "OPEKA_PUNA" SHAPE "RECTANGULAR" T3 0.24 T2 0.14

$ SHELL SECTIONS
  SHELL "WALL_60" TYPE "WALL" MAT "OPEKA_PUNA" THICKNESS 0.60
  SHELL "WALL_45" TYPE "WALL" MAT "OPEKA_PUNA" THICKNESS 0.45
  SHELL "WALL_38" TYPE "WALL" MAT "OPEKA_PUNA" THICKNESS 0.38
  SHELL "SLAB_TIMBER" TYPE "SLAB" MAT "OPEKA_PUNA" THICKNESS 0.22

$ POINT COORDINATES
  POINT "J1" X 20.30 Y 0.30 Z 0.0
  POINT "J2" X 20.30 Y 14.20 Z 0.0
  POINT "J3" X 0.30 Y 7.25 Z 0.0
  POINT "J4" X 40.30 Y 7.25 Z 0.0
  POINT "J5" X 10.69 Y 3.70 Z 0.0
  POINT "J6" X 20.49 Y 3.70 Z 0.0
  POINT "J7" X 30.29 Y 3.70 Z 0.0
  POINT "J1_T" X 20.30 Y 0.30 Z 4.59
  POINT "J2_T" X 20.30 Y 14.20 Z 4.59
  POINT "J3_T" X 0.30 Y 7.25 Z 4.59
  POINT "J4_T" X 40.30 Y 7.25 Z 4.59
  POINT "J5_T" X 10.69 Y 3.70 Z 4.59
  POINT "J6_T" X 20.49 Y 3.70 Z 4.59
  POINT "J7_T" X 30.29 Y 3.70 Z 4.59
  POINT "J8" X 20.00 Y 7.50 Z 2.30
  POINT "J9" X 21.60 Y 7.50 Z 2.30

$ LINE CONNECTIVITIES
  LINE "BM_NPI_1" FRAME "NPI_200" J1 "J8" J2 "J9"

$ AREA CONNECTIVITIES
  AREA "W_JUG" PROP "WALL_60" TYPE "WALL" PT J1 J1_T J1_T J1
  AREA "W_SJEVER" PROP "WALL_60" TYPE "WALL" PT J2 J2_T J2_T J2
  AREA "W_ZAPAD" PROP "WALL_60" TYPE "WALL" PT J3 J3_T J3_T J3
  AREA "W_ISTOK" PROP "WALL_60" TYPE "WALL" PT J4 J4_T J4_T J4
  AREA "W_TR1" PROP "WALL_38" TYPE "WALL" PT J5 J5_T J5_T J5
  AREA "W_TR2" PROP "WALL_38" TYPE "WALL" PT J6 J6_T J6_T J6
  AREA "W_TR3" PROP "WALL_38" TYPE "WALL" PT J7 J7_T J7_T J7

$ POINT RESTRAINTS
  RESTRAINT "J1" U1 YES U2 YES U3 YES R1 YES R2 YES R3 YES
  RESTRAINT "J2" U1 YES U2 YES U3 YES R1 YES R2 YES R3 YES
  RESTRAINT "J3" U1 YES U2 YES U3 YES R1 YES R2 YES R3 YES
  RESTRAINT "J4" U1 YES U2 YES U3 YES R1 YES R2 YES R3 YES
  RESTRAINT "J5" U1 YES U2 YES U3 YES R1 YES R2 YES R3 YES
  RESTRAINT "J6" U1 YES U2 YES U3 YES R1 YES R2 YES R3 YES
  RESTRAINT "J7" U1 YES U2 YES U3 YES R1 YES R2 YES R3 YES

$ STATIC LOADS
  LOADPATTERN "DEAD" TYPE "DEAD" SELFWT 1.0
  LOADPATTERN "LIVE_SKOLA" TYPE "LIVE" SELFWT 0.0

$ END OF MODEL FILE
