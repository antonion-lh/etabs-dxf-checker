; ETABS .e2k Model Text File (Sample Multistory Building)
; Generated for ETABS v23 Cross-Validation Demo

$ PROGRAM INFORMATION
  PROGRAM "ETABS" VERSION "23.0.0"

$ MATERIAL PROPERTIES
  MATERIAL "C30/37" TYPE "CONCRETE"
  MATERIAL "C30/37" ISOTROPIC E 33000000 U 0.2
  MATERIAL "C30/37" DESIGN "CONCRETE" FC 30000

  MATERIAL "C25/30" TYPE "CONCRETE"
  MATERIAL "C25/30" ISOTROPIC E 31000000 U 0.2
  MATERIAL "C25/30" DESIGN "CONCRETE" FC 25000

  MATERIAL "B500B" TYPE "REBAR"
  MATERIAL "B500B" ISOTROPIC E 200000000 U 0.3
  MATERIAL "B500B" DESIGN "REBAR" FY 500000 FU 550000

  MATERIAL "S355" TYPE "STEEL"
  MATERIAL "S355" ISOTROPIC E 210000000 U 0.3
  MATERIAL "S355" DESIGN "STEEL" FY 355000 FU 510000

$ FRAME SECTIONS
  FRAME "COL_40x50" MAT "C30/37" SHAPE "RECTANGULAR" T3 0.50 T2 0.40
  FRAME "COL_CIRC_45" MAT "C30/37" SHAPE "CIRCULAR" T3 0.45
  FRAME "COL_30x60" MAT "C30/37" SHAPE "RECTANGULAR" T3 0.60 T2 0.30
  FRAME "BM_30x40" MAT "C25/30" SHAPE "RECTANGULAR" T3 0.40 T2 0.30

$ SHELL SECTIONS
  SHELL "WALL_25" TYPE "WALL" MAT "C30/37" THICKNESS 0.25
  SHELL "SLAB_20" TYPE "SLAB" MAT "C30/37" THICKNESS 0.20

$ POINT COORDINATES
  POINT "1" X 0.0 Y 0.0 Z 0.0
  POINT "2" X 0.0 Y 0.0 Z 3.2
  POINT "3" X 6.0 Y 0.0 Z 0.0
  POINT "4" X 6.0 Y 0.0 Z 3.2
  POINT "5" X 12.0 Y 0.0 Z 0.0
  POINT "6" X 12.0 Y 0.0 Z 3.2
  POINT "7" X 6.0 Y 6.0 Z 3.2
  POINT "8" X 6.0 Y 6.0 Z 6.4
  POINT "9" X 0.0 Y 3.0 Z 0.0
  POINT "10" X 0.0 Y 5.5 Z 0.0
  POINT "11" X 0.0 Y 5.5 Z 3.2
  POINT "12" X 0.0 Y 3.0 Z 3.2
  POINT "13" X 6.0 Y 6.0 Z 3.2
  POINT "14" X 0.0 Y 6.0 Z 3.2

$ LINE CONNECTIVITIES
  LINE "C1" TYPE "COLUMN" I "1" J "2" PROP "COL_40x50"
  LINE "C2" TYPE "COLUMN" I "3" J "4" PROP "COL_CIRC_45"
  LINE "C3" TYPE "COLUMN" I "5" J "6" PROP "COL_30x60"
  LINE "C4_ROOF" TYPE "COLUMN" I "7" J "8" PROP "COL_40x50"
  LINE "B101" TYPE "BEAM" I "2" J "4" PROP "BM_30x40"

$ AREA CONNECTIVITIES
  AREA "W1" TYPE "WALL" NUMPTS 4 PT "9" "10" "11" "12" PROP "WALL_25"
  AREA "SLAB_BAY1" TYPE "FLOOR" NUMPTS 4 PT "2" "4" "13" "14" PROP "SLAB_20"

$ LOAD PATTERNS
  PATTERN "DEAD" TYPE "DEAD" SELFWT 1.0
  PATTERN "SDL" TYPE "SUPER DEAD" SELFWT 0.0
  PATTERN "LIVE" TYPE "LIVE" SELFWT 0.0
  PATTERN "WIND_X" TYPE "WIND" SELFWT 0.0

$ AREA OBJECT LOADS
  UNIFORM "SLAB_BAY1" PAT "SDL" DIR 3 VAL 2.0
  UNIFORM "SLAB_BAY1" PAT "LIVE" DIR 3 VAL 3.0

$ FRAME OBJECT LOADS
  DISTRIBUTED "B101" PAT "SDL" DIR 10 VAL1 4.5 VAL2 4.5

$ POINT ASSIGNMENTS
  RESTRAINT "1" U1 YES U2 YES U3 YES R1 YES R2 YES R3 YES
  RESTRAINT "3" U1 YES U2 YES U3 YES R1 YES R2 YES R3 YES
  RESTRAINT "5" U1 YES U2 YES U3 YES R1 YES R2 YES R3 YES
  RESTRAINT "9" U1 YES U2 YES U3 YES R1 YES R2 YES R3 YES
  RESTRAINT "10" U1 YES U2 YES U3 YES R1 YES R2 YES R3 YES

$ FRAME HINGE ASSIGNMENTS
  HINGE "C1" PROP "P-M2-M3_Auto" RELDIST 0.05 DOF "P-M2-M3"
  HINGE "C1" PROP "P-M2-M3_Auto" RELDIST 0.95 DOF "P-M2-M3"
